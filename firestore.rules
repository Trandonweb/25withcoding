rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // 관리자 권한은 신뢰할 수 있는 서버(Firebase Admin SDK)가 부여한
    // Firebase Authentication custom claim으로만 판단한다.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // 로그인한 계정의 이메일에서 학번을 확인한다.
    function isOwnStudent(studentId) {
      return signedIn()
        && request.auth.token.email == studentId + '@auth.25withcoding.kr';
    }

    match /users/{studentId} {
      // 학생은 본인 문서만, 관리자는 모든 학생 문서를 읽을 수 있다.
      allow get: if isOwnStudent(studentId) || isAdmin();
      allow list: if isAdmin();

      // 학생은 본인 문서만 생성·수정·삭제할 수 있고,
      // 관리자는 모든 학생 문서를 관리할 수 있다.
      allow create, update, delete: if isOwnStudent(studentId) || isAdmin();
    }

    // users 이외의 컬렉션은 별도 정책을 검토하기 전까지 모두 차단한다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
